// Metodos
package metodos;

public class sistema {
    private String nombre;
    private int nivelEnergia;
    private String estado;
    public sistema(String nombre,
                   int nivelEnergia,
                   String estado) {

        this.nombre = nombre;
        if(nivelEnergia >= 0 && nivelEnergia <= 100){

            this.nivelEnergia = nivelEnergia;

        }else{

            this.nivelEnergia = 0;
        }

        this.estado = estado;
    }
    public int getNivelEnergia() {
        return nivelEnergia;
    }

    public String getEstado() {
        return estado;
    }
    public void setNivelEnergia(int nivelEnergia) {

        if(nivelEnergia >= 0 && nivelEnergia <= 100){

            this.nivelEnergia = nivelEnergia;

        }else{

            System.out.println("Nivel inválido");
        }
    }

    public void setEstado(String estado) {
        this.estado = estado;
    }
    public void mostrarEstado() {

        System.out.println("Nombre: " + nombre);
        System.out.println("Nivel de energía: "
                + nivelEnergia);
        System.out.println("Estado: " + estado);
    }
}

//Interfaz
package INTERFAZ;

import metodos.sistema;

public class Main {

    public static void main(String[] args) {

        final int MAX = 2;
        sistema agentes[] = new sistema[MAX];

        agentes[0] =
                new sistema("Alpha",80,"activo");

        agentes[1] =
                new sistema("Beta",45,"inactivo");

        for(int i = 0; i < agentes.length; i++){

            agentes[i].mostrarEstado();
        }

        agentes[0].setNivelEnergia(95);

        agentes[0].setEstado("activo");

        System.out.println("\nNuevo estado:");

        agentes[0].mostrarEstado();
    }
}
